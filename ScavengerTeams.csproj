<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(PROBABLY_STOLEN_GAME_ROOT)</GameRoot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="$(GameRoot)\Probably Stolen_Data\Managed\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)\Probably Stolen_Data\Managed\Assembly-CSharp.dll')"
           Text="Set GameRoot to a local Probably Stolen installation; game assemblies are not distributed here." />
  </Target>
</Project>
